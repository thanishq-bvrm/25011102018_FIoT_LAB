  {
    "id": "fn_bme280_processor",
    "type": "function",
    "z": "tab_bme280_iot_project",
    "name": "BME280 Analytics & Meteorological Engine",
    "func": "// Parse incoming BME280 JSON payload\nlet data = msg.payload;\nif (typeof data === \"string\") {\n    try {\n        data = JSON.parse(data);\n    } catch (e) {\n        node.error(\"Invalid JSON received: \" + e.message, msg);\n        return null;\n    }\n}\n\nlet temp = parseFloat(data.temperature);\nlet press = parseFloat(data.pressure);\nlet hum = parseFloat(data.humidity);\n\nif (isNaN(temp) || isNaN(press) || isNaN(hum)) {\n    node.warn(\"Missing or invalid numeric metrics in payload\");\n    return null;\n}\n\n// 1. Magnus formula for Dew Point (\u00b0C)\nlet a = 17.27;\nlet b = 237.7;\nlet alpha = ((a * temp) / (b + temp)) + Math.log(hum / 100.0);\nlet dewPoint = (b * alpha) / (a - alpha);\ndewPoint = Math.round(dewPoint * 10) / 10;\n\n// 2. Heat Index / Feels Like (\u00b0C)\nlet T_F = (temp * 9 / 5) + 32;\nlet HI_F = 0.5 * (T_F + 61.0 + ((T_F - 68.0) * 1.2) + (hum * 0.094));\nif (HI_F >= 80) {\n    HI_F = -42.379 + 2.04901523 * T_F + 10.14333127 * hum\n           - 0.22475541 * T_F * hum - 0.00683783 * T_F * T_F\n           - 0.05481717 * hum * hum + 0.00122874 * T_F * T_F * hum\n           + 0.00085282 * T_F * hum * hum - 0.00000199 * T_F * T_F * hum * hum;\n}\nlet feelsLike = (HI_F - 32) * 5 / 9;\nfeelsLike = Math.round(feelsLike * 10) / 10;\n\n// 3. Barometric Altitude Estimate (m)\nlet altitude = 44330.0 * (1.0 - Math.pow(press / 1013.25, 0.1903));\naltitude = Math.round(altitude);\n\n// 4. Barometric Forecast / Trend\nlet forecast = \"Stable / Normal\";\nif (press > 1022.0) {\n    forecast = \"Fair & Clear (High Pressure)\";\n} else if (press < 995.0) {\n    forecast = \"Storm Alert (Very Low Pressure)\";\n} else if (press < 1009.0) {\n    forecast = \"Unsettled / Rain Possible\";\n}\n\n// 5. Thermal Comfort Assessment\nlet comfort = \"Optimal\";\nlet comfortColor = \"#22c55e\";\nif (temp > 35.0 || feelsLike > 38.0) {\n    comfort = \"Extreme Heat Warning\";\n    comfortColor = \"#ef4444\";\n} else if (temp > 30.0) {\n    comfort = \"Warm / Humid\";\n    comfortColor = \"#f59e0b\";\n} else if (temp < 18.0) {\n    comfort = \"Cool\";\n    comfortColor = \"#3b82f6\";\n}\n\n// 6. Packet Counter and Time\nlet count = (context.get(\"packetCount\") || 0) + 1;\ncontext.set(\"packetCount\", count);\n\nlet now = new Date();\nlet timeStr = now.toLocaleTimeString();\n\n// Format Outputs\nlet msgTemp = { payload: temp, topic: \"Temperature\", units: \"\u00b0C\" };\nlet msgHum = { payload: hum, topic: \"Humidity\", units: \"%\" };\nlet msgPress = { payload: press, topic: \"Pressure\", units: \"hPa\" };\n\nlet msgAnalytics = {\n    payload: {\n        temperature: temp,\n        humidity: hum,\n        pressure: press,\n        dewPoint: dewPoint,\n        feelsLike: feelsLike,\n        altitude: altitude,\n        forecast: forecast,\n        comfort: comfort,\n        comfortColor: comfortColor,\n        packetCount: count,\n        lastSeen: timeStr\n    },\n    topic: \"Analytics\"\n};\n\n// Alert message\nlet msgAlert = null;\nif (temp >= 35.0) {\n    msgAlert = {\n        payload: `\u26a0\ufe0f High Temperature Alert: ${temp.toFixed(1)}\u00b0C recorded!`,\n        topic: \"Alert\"\n    };\n} else if (press < 995.0) {\n    msgAlert = {\n        payload: `\u26c8\ufe0f Rapid Barometric Drop Alert: ${press.toFixed(1)} hPa!`,\n        topic: \"Alert\"\n    };\n}\n\nreturn [msgTemp, msgHum, msgPress, msgAnalytics, msgAlert];",
    "outputs": 5,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 520,
    "y": 160,
    "wires": [

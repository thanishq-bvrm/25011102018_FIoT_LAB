  {
    "id": "card_station_overview",
    "type": "ui_template",
    "z": "tab_bme280_iot_project",
    "group": "grp_bme280_card",
    "name": "Weather Station Card",
    "order": 1,
    "width": "12",
    "height": "6",
    "format": "<div style=\"font-family:'Segoe UI',sans-serif; background:linear-gradient(135deg, #1e293b 0%, #0f172a 100%); color:#f8fafc; border-radius:14px; padding:18px; box-shadow:0 8px 24px rgba(0,0,0,0.3); border:1px solid #334155;\">\n    <!-- Header -->\n    <div style=\"display:flex; justify-content:space-between; align-items:center; margin-bottom:14px; border-bottom:1px solid #334155; padding-bottom:10px;\">\n        <div style=\"display:flex; align-items:center; gap:10px;\">\n            <span style=\"font-size:26px;\">\ud83c\udf26\ufe0f</span>\n            <div>\n                <div style=\"font-weight:700; font-size:17px; letter-spacing:0.5px; color:#38bdf8;\">STM32 BME280 STATION</div>\n                <div style=\"font-size:11px; color:#94a3b8;\">Topic: college/weather/bme280</div>\n            </div>\n        </div>\n        <div style=\"display:flex; align-items:center; gap:6px; background:#064e3b; padding:4px 10px; border-radius:20px; border:1px solid #059669;\">\n            <div style=\"width:8px; height:8px; background:#10b981; border-radius:50%; box-shadow:0 0 8px #10b981;\"></div>\n            <span style=\"font-size:11px; font-weight:600; color:#a7f3d0;\">LIVE</span>\n        </div>\n    </div>\n\n    <!-- Main Live Metrics Grid -->\n    <div style=\"display:grid; grid-template-columns:1fr 1fr 1fr; gap:12px; margin-bottom:14px;\">\n        <!-- Temp -->\n        <div style=\"background:#1e293b; border-radius:10px; padding:12px; text-align:center; border:1px solid #334155;\">\n            <div style=\"font-size:12px; color:#94a3b8; font-weight:600; text-transform:uppercase;\">Temperature</div>\n            <div style=\"font-size:24px; font-weight:800; color:#f87171; margin:4px 0;\">{{msg.payload.temperature | number:1}} <span style=\"font-size:14px; font-weight:500;\">\u00b0C</span></div>\n            <div style=\"font-size:10px; color:#cbd5e1;\">Feels like {{msg.payload.feelsLike | number:1}}\u00b0C</div>\n        </div>\n        <!-- Humidity -->\n        <div style=\"background:#1e293b; border-radius:10px; padding:12px; text-align:center; border:1px solid #334155;\">\n            <div style=\"font-size:12px; color:#94a3b8; font-weight:600; text-transform:uppercase;\">Humidity</div>\n            <div style=\"font-size:24px; font-weight:800; color:#38bdf8; margin:4px 0;\">{{msg.payload.humidity | number:1}} <span style=\"font-size:14px; font-weight:500;\">%</span></div>\n            <div style=\"font-size:10px; color:#cbd5e1;\">Dew Point {{msg.payload.dewPoint | number:1}}\u00b0C</div>\n        </div>\n        <!-- Pressure -->\n        <div style=\"background:#1e293b; border-radius:10px; padding:12px; text-align:center; border:1px solid #334155;\">\n            <div style=\"font-size:12px; color:#94a3b8; font-weight:600; text-transform:uppercase;\">Pressure</div>\n            <div style=\"font-size:24px; font-weight:800; color:#a78bfa; margin:4px 0;\">{{msg.payload.pressure | number:1}} <span style=\"font-size:12px; font-weight:500;\">hPa</span></div>\n            <div style=\"font-size:10px; color:#cbd5e1;\">Alt ~{{msg.payload.altitude}} m</div>\n        </div>\n    </div>\n\n    <!-- Meteorological Summary Row -->\n    <div style=\"background:#0f172a; border-radius:10px; padding:10px 14px; display:flex; justify-content:space-between; align-items:center; border:1px solid #1e293b; font-size:12px;\">\n        <div>\n            <span style=\"color:#94a3b8;\">Forecast:</span> <strong style=\"color:#f1f5f9;\">{{msg.payload.forecast}}</strong>\n        </div>\n        <div>\n            <span style=\"color:#94a3b8;\">Thermal State:</span> <strong ng-style=\"{'color': msg.payload.comfortColor}\">{{msg.payload.comfort}}</strong>\n        </div>\n    </div>\n\n    <!-- Footer Stats -->\n    <div style=\"margin-top:12px; display:flex; justify-content:space-between; font-size:11px; color:#64748b;\">\n        <span>Last Packet: <strong style=\"color:#94a3b8;\">{{msg.payload.lastSeen}}</strong></span>\n        <span>Packets Ingested: <strong style=\"color:#94a3b8;\">{{msg.payload.packetCount}}</strong></span>\n    </div>\n</div>",
    "storeOutMessages": true,
    "fwdInMessages": true,
    "resendOnRefresh": true,
    "templateScope": "local",
    "className": "",
    "x": 860,
    "y": 80,
    "wires": [

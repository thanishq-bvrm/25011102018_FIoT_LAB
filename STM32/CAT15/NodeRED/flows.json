  {
    "id": "inj_mock_bme280",
    "type": "inject",
    "z": "tab_bme280_iot_project",
    "name": "Simulate BME280 Data (Offline Test)",
    "props": [
      {
        "p": "payload"
      },
      {
        "p": "topic",
        "vt": "str"
      }
    ],
    "repeat": "",
    "crontab": "",
    "once": false,
    "onceDelay": 0.1,
    "topic": "college/weather/bme280",
    "payload": "{\"temperature\":28.50,\"pressure\":1013.25,\"humidity\":65.20}",
    "payloadType": "json",
    "x": 200,
    "y": 200,
    "wires": [
      [
        "fn_bme280_processor"
      ]
    ]
